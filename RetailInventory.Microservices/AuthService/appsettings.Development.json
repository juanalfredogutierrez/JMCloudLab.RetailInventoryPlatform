  },

  "OpenTelemetry": {
    "ServiceNamespace": "RetailInventory",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://localhost:4317",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "EnableOtlpExporter": true
  },

  "HealthChecks": {
    "EnableSelfCheck": true,
    "EnableSqlServer": true
  } 
