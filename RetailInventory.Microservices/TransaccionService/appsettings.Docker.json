{
  "Services": {
    "ProductoApi": "http://productoservice:8080",
    "InventarioApi": "http://inventarioservice:8080"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Serilog": {
    "SeqUrl": "http://seq"
  },
  "Resilience": {
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelayInSeconds": 2,
      "UseExponentialBackoff": true
    },
    "Timeout": {
      "TimeoutInSeconds": 10
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDurationInSeconds": 30,
      "BreakDurationInSeconds": 30
    }
  },
  "Observability": {
    "ApplicationName": "TransaccionService",
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableSeq": true,
    "SeqUrl": "http://seq"
  },

  "OpenTelemetry": {
    "ServiceNamespace": "RetailInventory",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://jaeger:4317",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "EnableOtlpExporter": true
  }
}