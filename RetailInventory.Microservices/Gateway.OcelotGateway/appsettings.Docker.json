{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "JMCloudLab",
    "Audience": "JMCloudLabUsers",
    "SecretKey": "THIS_IS_A_SUPER_SECURE_KEY_1234567890_ABCDEF"
  },
  "Observability": {
    "ApplicationName": "Gateway.OcelotGateway",
    "MinimumLevel": "Information",
    "EnableConsole": true,
    "EnableSeq": true,
    "SeqUrl": "http://seq"
  },

  "OpenTelemetry": {
    "ServiceNamespace": "RetailInventory",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://jaeger:4317",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "EnableOtlpExporter": true
  }
}